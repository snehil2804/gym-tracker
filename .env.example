# Supabase project URL and publishable (anon) key.
# Both are safe to expose to the browser: every table is protected by Row Level Security.
# Never put the service_role / secret key here or anywhere in the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: set to "false" to hide the sign-up form (sign-in only).
NEXT_PUBLIC_ALLOW_SIGNUP=true
